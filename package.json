{
  "name": "folio-v1",
  "version": "1.0.0",
  "private": true,
  "_comment_sharp": "sharp is intentionally NOT a root dependency. Next 16 declares sharp ^0.34.4 as its own optional dependency and uses that for next/image. The old root pin (^0.32.0) resolved to 0.32.6, whose postinstall downloads libvips over the network; when that download fails the whole `npm install` aborts and NOTHING is installed, which surfaces confusingly as 'Module not found: marked'. Do not re-add it.",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/preflight.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "build:analyze": "ANALYZE=true next build",
    "reinstall": "rm -rf node_modules package-lock.json .next && npm install"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.2",
    "@vercel/analytics": "^0.1.11",
    "eslint": "8.35.0",
    "eslint-config-next": "13.2.3",
    "framer-motion": "^10.6.1",
    "gsap": "^3.11.5",
    "marked": "^18.0.9",
    "next": "^16.0.1",
    "node-html-parser": "^9.0.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "react-intersection-observer": "^9.4.3",
    "resize-observer-polyfill": "^1.5.1",
    "scroller-motion": "^1.2.3",
    "touch-cli": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "18.15.0",
    "@types/react": "18.0.28",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.5",
    "tailwind-scrollbar": "^3.0.0",
    "tailwindcss": "^3.2.7",
    "typescript": "^5.1.0"
  }
}
