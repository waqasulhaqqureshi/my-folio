# Admin panel (double-tap the footer copyright, or visit /admin)
#
# ADMIN_PASSWORD — the password the gate asks for.
#                  Defaults to "admin" in development only.
# ADMIN_SECRET   — HMAC key that signs the admin session cookie. Must be
#                  >=16 chars. The app REFUSES to start an admin session in
#                  production without it, so a public default key can never
#                  be used to forge a session.
#                  Generate one:  openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-with-openssl-rand-hex-32
