/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.log
.vscode/
.idea/
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin panel: uploaded hero images and the editable content document are
# runtime state, not source. Keep them out of git so a deploy never clobbers
# what was edited in production.
/public/uploads/
/data/

# public/uploaded/ is the hero portrait library: the folder is part of the repo
# (its README documents what to drop in, and the app reads it at runtime), but
# the images inside it are content, not source. Ignore everything, then
# un-ignore the README so the directory still exists in a fresh clone —
# git tracks files, not folders, so without that exception the folder would be
# missing on deploy and the listing route would 404 its own library.
/public/uploaded/*
!/public/uploaded/README.md
